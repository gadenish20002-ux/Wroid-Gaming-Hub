          "y": 900
        }
      }
    },
    {
      "name": "look_right",
      "input": {
        "kind": "key",
        "key": "d"
      },
      "action": {
        "kind": "swipe",
        "from": {
          "x": 960,
          "y": 540
        },
        "to": {
          "x": 1260,
          "y": 540
        },
        "duration_ms": 180
      }
    }
  ]
